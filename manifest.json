{
  "manifest_version": 3,
  "name": "CVAT 3D Fusion Suite (Pre-label & QA)",
  "version": "2.0.0",
  "description": "All-in-one CVAT 3D Cuboid: Pre-label đa model (CenterPoint + PointPillars-FPN + L-Shape + YOLO11s + ICP Tracker), QA Audit 9 luật + PCD, V2 Safe Assist, Size/Checklist & Mentor Issue. 100% nội bộ (127.0.0.1:8766).",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Mở CVAT 3D Fusion Pre-label"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:8080/*",
    "https://cvat.edufun.ai/*",
    "http://127.0.0.1:8766/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:8080/*",
        "https://cvat.edufun.ai/*"
      ],
      "js": [
        "src/page_bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://localhost:8080/*",
        "https://cvat.edufun.ai/*"
      ],
      "js": [
        "src/content_bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
